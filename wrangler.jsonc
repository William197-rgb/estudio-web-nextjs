// Static site on Cloudflare (Workers static assets). Deploy: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "william-acosta-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
